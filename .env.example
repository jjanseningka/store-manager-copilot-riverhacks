# Copy to .env and fill in. .env is gitignored.
# MCP servers read these at process start. Rotate any token that ever
# touches a shared machine.
#
# The default starter MCP set (filesystem + hello-world) does not need
# any of these. The slots below are examples for when you add a server
# that does.

# GitHub MCP server, if you add one. Personal access token, scoped
# read-only when possible. Create at https://github.com/settings/tokens
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Atlassian MCP server, if you add one.
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Database MCP server, if you add one.
# Never put a production DSN here. Local dev only.
# DATABASE_URL=postgres://localhost:5432/dev
